# Frontend: local UI connects to Monad Testnet
VITE_NETWORK=testnet
VITE_CONTRACT_ADDRESS=0xYourDeployedContractAddress
NFT_CONTRACT_ADDRESS=0xYourDeployedContractAddress

# Public collection settings
NFT_COLLECTION_NAME=oracle card
NFT_SYMBOL=FUCKINGORACLE
NFT_MINT_PRICE_MON=0.00145
NFT_MAX_MINTS_PER_WALLET=1000
NFT_OWNER=0xA4C755e353BBEBe003a73D7A1563931d7CDFD6C5

# Deployment wallet. NEVER share this value. Use a dedicated test wallet only.
PRIVATE_KEY=0xYourDedicatedTestnetPrivateKey

# Optional RPC overrides
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_MAINNET_RPC_URL=https://rpc.monad.xyz
